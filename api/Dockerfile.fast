# FASTER DOCKERFILE ALTERNATIVE
# This uses optimized installation order
# Much faster than compiling dlib separately

FROM python:3.10-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    cmake \
    build-essential \
    libopenblas-dev \
    liblapack-dev \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    libglib2.0-0 \
    libpng16-16 \
    libjpeg62-turbo \
    libwebp7 \
    libtiff6 \
    libboost-python-dev \
    libboost-system-dev \
    git \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip
RUN pip install --upgrade pip setuptools wheel

# Install dependencies in order (most time-consuming first)
# Install numpy first (needed by other packages)
RUN pip install --no-cache-dir numpy==1.24.3

# Install face_recognition (includes dlib as dependency - handles CMake issues)
ENV DLIB_NO_GUI_SUPPORT=1
RUN pip install --no-cache-dir face-recognition==1.3.0

# Install opencv
RUN pip install --no-cache-dir opencv-python-headless==4.8.1.78

# Install remaining dependencies
RUN pip install --no-cache-dir \
    fastapi==0.104.1 \
    uvicorn[standard]==0.24.0 \
    python-multipart==0.0.6 \
    sqlalchemy==2.0.23 \
    psycopg2-binary==2.9.9 \
    pgvector==0.2.3 \
    Pillow==10.1.0 \
    pydantic==2.5.0 \
    pydantic-settings==2.1.0 \
    python-dotenv==1.0.0

# Copy application code
COPY . .

# Expose port
EXPOSE 8000

# Command will be overridden by docker-compose
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]

